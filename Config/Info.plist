<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleDisplayName</key><string>Snag</string>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key><string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key><true/>
	<key>NSCameraUsageDescription</key>
	<string>Snag uses the camera to photograph the condition of each room. Photographs stay on this phone.</string>
	<key>UIAppFonts</key>
	<array><string>InterVariable.ttf</string></array>
	<!-- Painted the same colour as the splash so there is no white flash on handover. -->
	<key>UILaunchScreen</key>
	<dict><key>UIColorName</key><string>LaunchGround</string></dict>
	<key>UISupportedInterfaceOrientations</key>
	<array><string>UIInterfaceOrientationPortrait</string></array>
	<!-- A sealed bundle is a directory package; declaring it lets another
	     phone open one in Snag and see the verdict. -->
	<!-- The same bundle as one file, for the messaging apps that do not carry
	     a folder. A zip with its own extension, so Snag claims it and no other zip. -->
	<key>UTExportedTypeDeclarations</key>
	<array><dict>
		<key>UTTypeIdentifier</key><string>ng.snag.report</string>
		<key>UTTypeDescription</key><string>Snag sealed report</string>
		<key>UTTypeConformsTo</key><array><string>com.apple.package</string></array>
		<key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>snag</string></array></dict>
	</dict><dict>
		<key>UTTypeIdentifier</key><string>ng.snag.report-file</string>
		<key>UTTypeDescription</key><string>Snag sealed report, one file</string>
		<key>UTTypeConformsTo</key><array><string>com.pkware.zip-archive</string></array>
		<key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>snagz</string></array></dict>
	</dict></array>
	<key>CFBundleDocumentTypes</key>
	<array><dict>
		<key>CFBundleTypeName</key><string>Snag sealed report</string>
		<key>LSItemContentTypes</key><array><string>ng.snag.report</string><string>ng.snag.report-file</string></array>
		<key>LSHandlerRank</key><string>Owner</string>
		<key>LSTypeIsPackage</key><true/>
	</dict></array>
	<key>LSSupportsOpeningDocumentsInPlace</key><false/>
	<key>UIApplicationSceneManifest</key>
	<dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict>
</dict>
</plist>
